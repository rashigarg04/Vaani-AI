# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Gnani AI API Credentials
# Get your API Key from https://docs.gnani.ai/
GNANI_API_KEY=your_gnani_api_key_here
GNANI_BASE_URL=https://api.vachana.ai

# Speech-to-Text (Prisma) Settings
GNANI_PRISMA_MODEL=prisma-v3.0
GNANI_PRISMA_DEFAULT_LANG=indic-auto

# Text-to-Speech (Timbre) Settings
GNANI_TIMBRE_MODEL=timbre-v3.0
GNANI_TIMBRE_DEFAULT_VOICE=Shivani

# AI Reasoning Engine Configuration
# Supported providers: evon, gemini, openai, groq, openrouter, local_intelligent
AI_PROVIDER=local_intelligent

# Evon Model Configuration (if you have an Evon deployment endpoint)
EVON_API_URL=
EVON_API_KEY=
EVON_MODEL_NAME=evon-base

# Alternative LLM Provider Keys (Optional fallback or replacement)
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Database Configuration (Optional: guest in-memory mode active if omitted or unreachable)
MONGODB_URI=mongodb://localhost:27017/vaani_ai
